    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            if (sidebar && backdrop) {
                sidebar.classList.toggle('show');
                backdrop.classList.toggle('show');
            }
        }

        // Live notification polling for authenticated users
        @if (User.Identity?.IsAuthenticated == true)
        {
            <text>
            function updateNotificationsCount() {
                fetch('/api/notifications')
                    .then(response => {
                        if (!response.ok) return null;
                        return response.json();
                    })
                    .then(data => {
                        if (!data) return;
                        const topBadge = document.getElementById('navNotifBadge');
                        const sidebarBadges = document.querySelectorAll('.sidebarNotifBadge');
                        const count = data.unreadCount || 0;

                        if (topBadge) {
                            if (count > 0) {
                                topBadge.innerText = count > 99 ? '99+' : count;
                                topBadge.style.display = 'inline-block';
                            } else {
                                topBadge.style.display = 'none';
                            }
                        }

                        sidebarBadges.forEach(b => {
                            if (count > 0) {
                                b.innerText = count > 99 ? '99+' : count;
                                b.style.display = 'inline-block';
                            } else {
                                b.style.display = 'none';
                            }
                        });
                    })
                    .catch(() => {});
            }

            document.addEventListener('DOMContentLoaded', function () {
                updateNotificationsCount();
                setInterval(updateNotificationsCount, 30000);
            });
            </text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
