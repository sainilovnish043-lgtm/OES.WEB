<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Exam Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OES.WEB.styles.css" asp-append-version="true" />
    <!-- Chart.js for Interactive Charts & Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var currentPath = Context.Request.Path.Value ?? "";
    var isAdmin = User.IsInRole("Admin");

    <div class="app-wrapper">
        <!-- Sidebar Backdrop for Mobile -->
        <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

        <!-- Sidebar Navigation -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-page="/Index">
                    <span class="portal-brand-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                            <path d="M9 12h6"></path>
                            <path d="M9 16h6"></path>
                        </svg>
                    </span>
                    <span>Exam Portal</span>
                </a>
                <div>
                    <span class="sidebar-role-badge">@(isAdmin ? "Admin Console" : "Student Portal")</span>
                </div>
            </div>

            <div class="sidebar-body">
                @if (isAdmin)
                {
                    <div class="sidebar-section-title">Overview</div>
                    <ul class="sidebar-nav">
                        <li>
                            <a asp-page="/Admin/Index" class="sidebar-link @(currentPath.Equals("/Admin", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/Admin/Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                    </svg>
                                </span>
                                <span>Dashboard & Charts</span>
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-section-title">Examination Management</div>
                    <ul class="sidebar-nav">
                        <li>
                            <a asp-page="/Admin/Exams/Index" class="sidebar-link @(currentPath.StartsWith("/Admin/Exams", StringComparison.OrdinalIgnoreCase) && !currentPath.Contains("/Create") ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                    </svg>
                                </span>
                                <span>All Examinations</span>
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Admin/Exams/Create" class="sidebar-link @(currentPath.Equals("/Admin/Exams/Create", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="16"></line>
                                        <line x1="8" y1="12" x2="16" y2="12"></line>
                                    </svg>
                                </span>
                                <span>Create New Exam</span>
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-section-title">Performance & Students</div>
                    <ul class="sidebar-nav">
                        <li>
                            <a asp-page="/Admin/Results/Index" class="sidebar-link @(currentPath.StartsWith("/Admin/Results", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                </span>
                                <span>Results & GridView</span>
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Admin/Students/Index" class="sidebar-link @(currentPath.StartsWith("/Admin/Students", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                </span>
                                <span>Student Directory</span>
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Notifications/Index" class="sidebar-link @(currentPath.StartsWith("/Notifications", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                    </svg>
                                </span>
                                <span>Notifications</span>
                                <span class="badge bg-danger rounded-pill ms-auto sidebarNotifBadge" style="display:none; font-size: 0.7rem;">0</span>
                            </a>
                        </li>
                    </ul>
                }
                else
                {
                    <div class="sidebar-section-title">Student Portal</div>
                    <ul class="sidebar-nav">
                        <li>
                            <a asp-page="/Student/Dashboard" class="sidebar-link @(currentPath.Equals("/Student/Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                    </svg>
                                </span>
                                <span>My Dashboard & Charts</span>
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Student/Exams/Index" class="sidebar-link @(currentPath.StartsWith("/Student/Exams", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                                        <polyline points="10 2 10 10 13 7 16 10 16 2"></polyline>
                                    </svg>
                                </span>
                                <span>Available Exams</span>
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Student/Results/Index" class="sidebar-link @(currentPath.StartsWith("/Student/Results", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                </span>
                                <span>My Results & Scores</span>
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Student/Profile" class="sidebar-link @(currentPath.Equals("/Student/Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                </span>
                                <span>My Profile & 2FA</span>
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Notifications/Index" class="sidebar-link @(currentPath.StartsWith("/Notifications", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                    </svg>
                                </span>
                                <span>Notifications</span>
                                <span class="badge bg-danger rounded-pill ms-auto sidebarNotifBadge" style="display:none; font-size: 0.7rem;">0</span>
                            </a>
                        </li>
                    </ul>
                }
            </div>

            <div class="sidebar-footer">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="text-truncate me-2">
                        <div class="small fw-bold text-white text-truncate">@User.Identity.Name</div>
                        <div class="text-white-50" style="font-size: 0.75rem;">Logged In</div>
                    </div>
                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-light rounded-circle p-1" title="Sign out" style="width: 32px; height: 32px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="app-main">
            <!-- App Topbar -->
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="toggleSidebar()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <span class="fw-semibold text-muted small">@ViewData["Title"]</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <!-- Notifications Bell Icon -->
                    <a asp-page="/Notifications/Index" class="btn btn-sm btn-outline-secondary position-relative rounded-circle p-2" title="Notifications" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span id="navNotifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none; font-size: 0.65rem;">
                            0
                        </span>
                    </a>
                    <a asp-page="/Index" class="btn btn-sm btn-outline-purple btn-pill px-3">
                        Public Portal
                    </a>
                    <span class="badge @(isAdmin ? "bg-purple text-white" : "bg-primary") rounded-pill px-3 py-2">
                        @(isAdmin ? "Admin" : "Student")
                    </span>
                </div>
            </header>

            <!-- Page Content -->
            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <!-- Guest Layout (Top Navbar) -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark portal-navbar mb-4">
            <div class="container">
                <a class="portal-brand" asp-area="" asp-page="/Index">
                    <span class="portal-brand-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                            <path d="M9 12h6"></path>
                            <path d="M9 16h6"></path>
                        </svg>
                    </span>
                    Exam Portal
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNavbar" aria-controls="portalNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="portalNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="portal-nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="portal-nav-link" asp-area="" asp-page="/Account/Login">Exams</a>
                        </li>
                        <li class="nav-item">
                            <a class="portal-nav-link" asp-area="" asp-page="/Account/Login">Results</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        <li class="nav-item">
                            <a class="btn btn-pill btn-sm btn-purple px-4" asp-page="/Account/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-pill btn-sm btn-purple-outline px-4" asp-page="/Account/Register">Register</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 mt-5 bg-white text-muted">
        <div class="container text-center small">
            &copy; 2026 - <strong>Exam Portal</strong> | Online Examination and Result Management System
        </div>
    </footer>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            if (sidebar && backdrop) {
                sidebar.classList.toggle('show');
                backdrop.classList.toggle('show');
            }
        }

        // Live notification polling for authenticated users
        @if (User.Identity?.IsAuthenticated == true)
        {
            <text>
            function updateNotificationsCount() {
                fetch('/api/notifications')
                    .then(response => {
                        if (!response.ok) return null;
                        return response.json();
                    })
                    .then(data => {
                        if (!data) return;
                        const topBadge = document.getElementById('navNotifBadge');
                        const sidebarBadges = document.querySelectorAll('.sidebarNotifBadge');
                        const count = data.unreadCount || 0;

                        if (topBadge) {
                            if (count > 0) {
                                topBadge.innerText = count > 99 ? '99+' : count;
                                topBadge.style.display = 'inline-block';
                            } else {
                                topBadge.style.display = 'none';
                            }
                        }

                        sidebarBadges.forEach(b => {
                            if (count > 0) {
                                b.innerText = count > 99 ? '99+' : count;
                                b.style.display = 'inline-block';
                            } else {
                                b.style.display = 'none';
                            }
                        });
                    })
                    .catch(() => {});
            }

            document.addEventListener('DOMContentLoaded', function () {
                updateNotificationsCount();
                setInterval(updateNotificationsCount, 30000);
            });
            </text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
