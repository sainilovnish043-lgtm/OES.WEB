@page
@model OES.WEB.Pages.Student.ProfileModel
@{
	ViewData["Title"] = "My profile";
}

<h1>My profile</h1>

@if (Model.Profile is null)
{
	<div class="alert alert-warning">Student profile was not found.</div>
}
else
{
	<dl class="row">
		<dt class="col-sm-3">Full name</dt>
		<dd class="col-sm-9">@Model.Profile.FullName</dd>
		<dt class="col-sm-3">Email</dt>
		<dd class="col-sm-9">@Model.Profile.Email</dd>
		<dt class="col-sm-3">Status</dt>
		<dd class="col-sm-9">@(Model.Profile.IsActive ? "Active" : "Inactive")</dd>
	</dl>
}
