@page
@model OES.WEB.Pages.Student.Results.IndexModel
@using OES.MODELS.Examinations
@{
}


<!-- Student Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background-color: #ede9fe; color: #6d28d9;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
            </div>
            <div>
                <div class="stat-number">@Model.TotalExamsTaken</div>
                <div class="stat-label">Exams Attempted</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background-color: #dcfce7; color: #16a34a;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div>
                <div class="stat-number text-success">@Model.PassedCount</div>
                <div class="stat-label">Exams Passed</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background-color: #fee2e2; color: #dc2626;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </div>
            <div>
                <div class="stat-number text-danger">@Model.FailedCount</div>
                <div class="stat-label">Exams Failed</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon" style="background-color: #e0f2fe; color: #0284c7;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <div>
                <div class="stat-number">@Model.OverallAverage%</div>
                <div class="stat-label">Average Score</div>
            </div>
        </div>
    </div>
</div>

<!-- Student GridView (Table) -->
<div class="gridview-card">
    <div class="gridview-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0 fw-bold">My Exam Results History</h2>
        <span class="badge bg-light text-dark border">@Model.Results.Count Exam(s)</span>
    </div>
    <div class="table-responsive">
        @if (Model.Results.Count == 0)
        {
        }
        else
        {
                <thead>
                    <tr>
                        <th>Percentage</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        var item = Model.Results[i];
                        <tr>
                        </tr>
                    }
                </tbody>
            </table>
	</div>
        }
    </div>
</div>
