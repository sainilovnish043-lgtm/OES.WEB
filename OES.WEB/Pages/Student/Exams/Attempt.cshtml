@page "{attemptId:int}"
@model OES.WEB.Pages.Student.Exams.AttemptModel
@using OES.MODELS.Examinations
@{
	ViewData["Title"] = Model.Session?.Exam.Title ?? "Exam attempt";
}

@if (Model.Session is null)
{
	<div class="alert alert-danger">This exam attempt could not be found.</div>
}
else if (Model.Session.Attempt.Status != AttemptStatuses.InProgress)
{
	<h1>@Model.Session.Exam.Title</h1>
	<div class="alert alert-warning">This attempt is @Model.Session.Attempt.Status.ToLowerInvariant() and is no longer available.</div>
}
else
{
	<div class="d-flex justify-content-between align-items-center mb-3">
		<div>
			<h1>@Model.Session.Exam.Title</h1>
			<p class="text-muted mb-0">@Model.Session.Exam.Description</p>
		</div>
		<div class="alert alert-warning mb-0">
			Time remaining: <strong id="time-remaining">--:--</strong>
		</div>
	</div>

	<form method="post" id="exam-form" data-expires-at="@Model.ExpiresUnixMilliseconds">
		<div asp-validation-summary="ModelOnly" class="text-danger"></div>
		@for (var index = 0; index < Model.Session.Questions.Count; index++)
		{
			var question = Model.Session.Questions[index];
			var answer = Model.Answers[index];
			<section class="card mb-3">
				<div class="card-body">
					<h2 class="h5">@(index + 1). @question.QuestionText</h2>
					<div class="text-muted mb-2">Marks: @question.Marks</div>
					<input type="hidden" name="Answers[@index].QuestionId" value="@answer.QuestionId" />
					@foreach (var option in question.Options)
					{
						<div class="form-check mb-2">
							<input class="form-check-input" type="radio"
								   id="option-@option.Id"
								   name="Answers[@index].SelectedOptionId"
								   value="@option.Id"
									  checked="@(answer.SelectedOptionId == option.Id ? "checked" : null)" />
							<label class="form-check-label" for="option-@option.Id">
								<strong>@option.OptionKey.</strong> @option.OptionText
							</label>
						</div>
					}
				</div>
			</section>
		}

		<button type="submit" class="btn btn-success">Submit exam</button>
	</form>
}

@if (Model.Session?.Attempt.Status == AttemptStatuses.InProgress)
{
	<script>
		(() => {
			const form = document.getElementById('exam-form');
			const output = document.getElementById('time-remaining');
			const expiresAt = Number(form.dataset.expiresAt);

			const updateTimer = () => {
				const remaining = Math.max(0, expiresAt - Date.now());
				const totalSeconds = Math.floor(remaining / 1000);
				const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
				const seconds = (totalSeconds % 60).toString().padStart(2, '0');
				output.textContent = `${minutes}:${seconds}`;
				if (remaining <= 0) {
					form.submit();
				}
			};

			updateTimer();
			window.setInterval(updateTimer, 1000);
		})();
	</script>
}
