@page
@model OES.WEB.Pages.Student.DashboardModel
@{
    ViewData["Title"] = "Student Dashboard";
    var fullName = Model.Profile is not null
        ? Model.Profile.FullName
        : User.Identity?.Name ?? "Student";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="h3 fw-bold mb-1">Welcome back, @fullName 👋</h2>
            <p class="text-muted mb-0">Track your exam performance, view test analytics, and attempt upcoming exams.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Student/Results/Index" class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-bar-graph"></i> My Results
            </a>
            <a asp-page="/Student/Profile" class="btn btn-primary">
                <i class="bi bi-person-gear"></i> Profile Settings
            </a>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fw-semibold small">Total Attempted</span>
                    <span class="badge bg-primary-subtle text-primary p-2 rounded-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    </span>
                </div>
                <div class="h2 fw-bold mb-0">@Model.TotalExamsAttempted</div>
                <div class="text-muted small mt-1">Completed exams</div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fw-semibold small">Passed</span>
                    <span class="badge bg-success-subtle text-success p-2 rounded-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </span>
                </div>
                <div class="h2 fw-bold text-success mb-0">@Model.PassedCount</div>
                <div class="text-muted small mt-1">Passed with qualifying mark</div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fw-semibold small">Failed / Retry</span>
                    <span class="badge bg-danger-subtle text-danger p-2 rounded-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                    </span>
                </div>
                <div class="h2 fw-bold text-danger mb-0">@Model.FailedCount</div>
                <div class="text-muted small mt-1">Needs improvement</div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fw-semibold small">Average Score</span>
                    <span class="badge bg-warning-subtle text-warning p-2 rounded-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </span>
                </div>
                <div class="h2 fw-bold mb-0">@Model.OverallAveragePercentage%</div>
                <div class="text-muted small mt-1">Across all examinations</div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <h5 class="fw-bold mb-3">Score Progress Trend</h5>
                <div style="height: 280px; position: relative;">
                    <canvas id="scoreTrendChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <h5 class="fw-bold mb-3">Pass / Fail Ratio</h5>
                <div style="height: 280px; position: relative;">
                    <canvas id="passFailChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Available Exams & Recent Results -->
    <div class="row g-3">
        <!-- Available Exams -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Available Exams</h5>
                    <span class="badge bg-primary">@Model.AvailableExams.Count Available</span>
                </div>
                @if (Model.AvailableExams.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <p class="mb-0">No active exams available at the moment.</p>
                        <small>Check back later when exams are scheduled.</small>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var exam in Model.AvailableExams)
                        {
                            <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-1">@exam.Title</h6>
                                    <div class="small text-muted">
                                        <span>⏱️ @exam.DurationMinutes mins</span>
                                        <span class="ms-2">🎯 Pass: @exam.PassingMarks / @exam.TotalMarks</span>
                                    </div>
                                </div>
                                <a asp-page="/Student/Exams/Take" asp-route-examId="@exam.Id" class="btn btn-sm btn-primary px-3">
                                    Start Exam
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Recent Results -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Recent Results</h5>
                    <a asp-page="/Student/Results/Index" class="small text-decoration-none">View All &rarr;</a>
                </div>
                @if (Model.Results.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <p class="mb-0">No exam attempts yet.</p>
                        <small>Attempt an exam to see your results here.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Exam</th>
                                    <th>Score</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in Model.Results.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@res.ExamTitle</div>
                                            <small class="text-muted">@res.SubmittedUtc.ToLocalTime().ToString("MMM dd, yyyy")</small>
                                        </td>
                                        <td>
                                            <span class="fw-bold">@res.ObtainedMarks / @res.TotalMarks</span>
                                            <div class="small text-muted">@res.Percentage%</div>
                                        </td>
                                        <td>
                                            @if (res.IsPassed)
                                            {
                                                <span class="badge bg-success-subtle text-success">Passed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Failed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Trend Chart
            const trendCtx = document.getElementById('scoreTrendChart');
            if (trendCtx) {
                const labels = @Html.Raw(Model.ExamTitlesJson);
                const data = @Html.Raw(Model.ScoresJson);

                if (labels.length > 0) {
                    new Chart(trendCtx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Score (%)',
                                data: data,
                                borderColor: '#6366f1',
                                backgroundColor: 'rgba(99, 102, 241, 0.15)',
                                fill: true,
                                tension: 0.35,
                                pointBackgroundColor: '#4f46e5',
                                pointRadius: 5
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: {
                                    min: 0,
                                    max: 100,
                                    ticks: { callback: v => v + '%' }
                                }
                            }
                        }
                    });
                } else {
                    trendCtx.parentElement.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 text-muted">No attempt data to display chart yet</div>';
                }
            }

            // Pass / Fail Ratio Chart
            const pfCtx = document.getElementById('passFailChart');
            if (pfCtx) {
                const counts = @Html.Raw(Model.PassFailJson);
                const total = counts[0] + counts[1];
                if (total > 0) {
                    new Chart(pfCtx, {
                        type: 'doughnut',
                        data: {
                            labels: ['Passed', 'Failed'],
                            datasets: [{
                                data: counts,
                                backgroundColor: ['#10b981', '#ef4444'],
                                hoverOffset: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom' }
                            }
                        }
                    });
                } else {
                    pfCtx.parentElement.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 text-muted">No attempts yet</div>';
                }
            }
        });
    </script>
}
