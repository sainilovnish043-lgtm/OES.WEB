@page
@model OES.WEB.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Analytics Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Administrative Analytics Dashboard</h1>
        <p class="text-muted mb-0">Live performance indicators, examination statistics, and student outcomes.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Admin/Exams/Create" class="btn btn-purple btn-pill btn-sm">
            + Create New Exam
        </a>
        <a asp-page="/Admin/Results/Index" class="btn btn-outline-secondary btn-pill btn-sm">
            View Full GridView
        </a>
    </div>
</div>

<!-- Stat Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon" style="background-color: #ede9fe; color: #6d28d9;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
            <div>
                <div class="stat-number">@Model.TotalStudents</div>
                <div class="stat-label">Enrolled Students</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon" style="background-color: #e0e7ff; color: #4338ca;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
            </div>
            <div>
                <div class="stat-number">@Model.TotalExams</div>
                <div class="stat-label">Total Exams (@Model.PublishedExamsCount Active)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon" style="background-color: #fef3c7; color: #d97706;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </div>
            <div>
                <div class="stat-number">@Model.TotalSubmissions</div>
                <div class="stat-label">Total Submissions</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon" style="background-color: #dcfce7; color: #15803d;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <div>
                <div class="stat-number text-success">@Model.PassRate%</div>
                <div class="stat-label">Overall Pass Rate</div>
            </div>
        </div>
    </div>
</div>

<!-- Interactive Charts Section -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Exam Average Scores Bar Chart -->
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-card-header">
                <div>
                    <h5 class="fw-bold mb-0">Examination Performance Comparison</h5>
                    <small class="text-muted">Average score vs. passing marks per examination</small>
                </div>
            </div>
            <div class="chart-container" style="height: 300px;">
                <canvas id="examPerformanceChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Pass vs Fail Ratio Doughnut Chart -->
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-card-header">
                <div>
                    <h5 class="fw-bold mb-0">Student Outcome Ratio</h5>
                    <small class="text-muted">Passed vs. Failed submissions</small>
                </div>
            </div>
            <div class="chart-container d-flex align-items-center justify-content-center" style="height: 300px;">
                <canvas id="outcomeDoughnutChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Exam Submissions Table -->
<div class="gridview-card">
    <div class="gridview-header d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Recent Examination Submissions</h5>
        <a asp-page="/Admin/Results/Index" class="btn btn-link btn-sm text-decoration-none">View All Results &rarr;</a>
    </div>
    <div class="table-responsive">
        @if (Model.RecentResults.Count == 0)
        {
            <div class="text-center py-4 text-muted small">No student attempts recorded yet.</div>
        }
        else
        {
            <table class="table gridview-table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Examination</th>
                        <th>Marks</th>
                        <th>Percentage</th>
                        <th>Status</th>
                        <th>Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model.RecentResults)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@result.StudentName</div>
                                <div class="small text-muted">@result.StudentEmail</div>
                            </td>
                            <td>@result.ExamTitle</td>
                            <td class="fw-bold">@result.ObtainedMarks / @result.TotalMarks</td>
                            <td>@result.Percentage%</td>
                            <td>
                                @if (result.IsPassed)
                                {
                                    <span class="badge-pass">Passed</span>
                                }
                                else
                                {
                                    <span class="badge-fail">Failed</span>
                                }
                            </td>
                            <td class="small text-muted">@result.SubmittedUtc.ToString("dd MMM, HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Chart 1: Exam Performance Bar Chart
        const examLabels = @Html.Raw(Model.ExamLabelsJson);
        const examAvgScores = @Html.Raw(Model.ExamAvgScoresJson);
        const examPassingScores = @Html.Raw(Model.ExamPassingScoresJson);

        const ctxBar = document.getElementById('examPerformanceChart').getContext('2d');
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: examLabels.length > 0 ? examLabels : ['No Data'],
                datasets: [
                    {
                        label: 'Average Score',
                        data: examAvgScores.length > 0 ? examAvgScores : [0],
                        backgroundColor: '#7c3aed',
                        borderRadius: 6,
                    },
                    {
                        label: 'Passing Benchmark',
                        data: examPassingScores.length > 0 ? examPassingScores : [0],
                        backgroundColor: '#cbd5e1',
                        borderRadius: 6,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: '#f1f5f9'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        // Chart 2: Pass vs Fail Doughnut Chart
        const passFailData = @Html.Raw(Model.PassFailDataJson);
        const ctxDoughnut = document.getElementById('outcomeDoughnutChart').getContext('2d');
        new Chart(ctxDoughnut, {
            type: 'doughnut',
            data: {
                labels: ['Passed', 'Failed'],
                datasets: [{
                    data: (passFailData[0] === 0 && passFailData[1] === 0) ? [1, 0] : passFailData,
                    backgroundColor: ['#16a34a', '#dc2626'],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true
                        }
                    }
                },
                cutout: '68%'
            }
        });
    });
</script>
}
