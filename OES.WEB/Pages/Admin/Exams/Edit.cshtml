@page "{id:int}"
@model OES.WEB.Pages.Admin.Exams.EditModel
@{
	ViewData["Title"] = "Edit examination";
}

<h1>Edit examination</h1>
<p class="text-muted">Only active draft exams can be edited.</p>

<form method="post">
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<div class="mb-3">
		<label asp-for="Input.Title" class="form-label"></label>
		<input asp-for="Input.Title" class="form-control" />
		<span asp-validation-for="Input.Title" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="Input.Description" class="form-label"></label>
		<textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
		<span asp-validation-for="Input.Description" class="text-danger"></span>
	</div>
	<div class="row">
		<div class="col-md-6 mb-3">
			<label asp-for="Input.StartLocal" class="form-label"></label>
			<input asp-for="Input.StartLocal" type="datetime-local" class="form-control" />
			<span asp-validation-for="Input.StartLocal" class="text-danger"></span>
		</div>
		<div class="col-md-6 mb-3">
			<label asp-for="Input.EndLocal" class="form-label"></label>
			<input asp-for="Input.EndLocal" type="datetime-local" class="form-control" />
			<span asp-validation-for="Input.EndLocal" class="text-danger"></span>
		</div>
	</div>
	<div class="row">
		<div class="col-md-4 mb-3">
			<label asp-for="Input.DurationMinutes" class="form-label"></label>
			<input asp-for="Input.DurationMinutes" class="form-control" />
			<span asp-validation-for="Input.DurationMinutes" class="text-danger"></span>
		</div>
		<div class="col-md-4 mb-3">
			<label asp-for="Input.TotalMarks" class="form-label"></label>
			<input asp-for="Input.TotalMarks" class="form-control" />
			<span asp-validation-for="Input.TotalMarks" class="text-danger"></span>
		</div>
		<div class="col-md-4 mb-3">
			<label asp-for="Input.PassingMarks" class="form-label"></label>
			<input asp-for="Input.PassingMarks" class="form-control" />
			<span asp-validation-for="Input.PassingMarks" class="text-danger"></span>
		</div>
	</div>
	<button type="submit" class="btn btn-primary">Save changes</button>
	<a asp-page="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
