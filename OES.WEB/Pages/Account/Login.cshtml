@page
@model OES.WEB.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="portal-brand-icon mx-auto mb-2" style="width: 44px; height: 44px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                        <path d="M9 12h6"></path>
                        <path d="M9 16h6"></path>
                    </svg>
                </div>
                <h1 class="h3 fw-bold mb-1">Welcome Back</h1>
                <p class="text-muted small">Sign in to your Exam Portal account</p>
            </div>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success small mb-3">@successMessage</div>
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

            <!-- Sign In with Google Button -->
            <form method="post" asp-page-handler="Google" asp-route-returnUrl="@Model.ReturnUrl" class="mb-3">
                <button type="submit" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-pill fw-semibold shadow-sm bg-white hover-shadow">
                    <svg width="20" height="20" viewBox="0 0 48 48">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    <span>Sign in with Google</span>
                </button>
            </form>

            <div class="position-relative text-center my-3">
                <hr class="text-muted" />
                <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">or sign in with email</span>
            </div>

            <!-- Standard Email & Password Form -->
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label small fw-semibold text-muted">Email Address</label>
                    <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="email" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label small fw-semibold text-muted">Password</label>
                    <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-purple btn-pill w-100 py-2 mt-2">Sign In</button>
            </form>

            <!-- Quick Demo Credentials Box -->
            <div class="mt-4 p-3 bg-light rounded-3 border">
                <div class="small fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
                    <span>⚡ Quick Test Logins</span>
                    <span class="badge bg-white text-primary border small">Click to fill</span>
                </div>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-sm btn-outline-dark d-flex justify-content-between align-items-center py-1 px-2 text-start" onclick="fillLogin('admin@oes.com', 'Admin@123')">
                        <div>
                            <span class="badge bg-purple text-white me-1">Admin</span>
                            <span class="small fw-semibold">admin@oes.com</span>
                        </div>
                        <span class="small text-muted">Admin@123 &rarr;</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-flex justify-content-between align-items-center py-1 px-2 text-start" onclick="fillLogin('student@oes.com', 'Student@123')">
                        <div>
                            <span class="badge bg-primary text-white me-1">Student</span>
                            <span class="small fw-semibold">student@oes.com</span>
                        </div>
                        <span class="small text-muted">Student@123 &rarr;</span>
                    </button>
                </div>
            </div>

            <div class="text-center mt-3">
                <span class="text-muted small">Don't have an account?</span>
                <a asp-page="/Account/Register" class="text-decoration-none fw-semibold small text-primary ms-1">Register as Student</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillLogin(email, password) {
            const emailInput = document.querySelector('input[name="Input.Email"]');
            const passInput = document.querySelector('input[name="Input.Password"]');
            if (emailInput && passInput) {
                emailInput.value = email;
                passInput.value = password;
            }
        }
    </script>
}
