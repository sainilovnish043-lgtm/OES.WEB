@page
@model OES.WEB.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Student Registration";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="portal-brand-icon mx-auto mb-2" style="width: 44px; height: 44px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <line x1="20" y1="8" x2="20" y2="14"></line>
                        <line x1="23" y1="11" x2="17" y2="11"></line>
                    </svg>
                </div>
                <h1 class="h3 fw-bold mb-1">Create Student Account</h1>
                <p class="text-muted small">Register to attempt online examinations and track results</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

            <!-- Sign Up with Google Button -->
            <form method="post" asp-page-handler="Google" class="mb-3">
                <button type="submit" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-pill fw-semibold shadow-sm bg-white hover-shadow">
                    <svg width="20" height="20" viewBox="0 0 48 48">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    <span>Sign up with Google</span>
                </button>
            </form>

            <div class="position-relative text-center my-3">
                <hr class="text-muted" />
                <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">or register with email</span>
            </div>

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label small fw-semibold text-muted">Full Name</label>
                    <input asp-for="Input.FullName" class="form-control rounded-3" autocomplete="name" placeholder="John Doe" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label small fw-semibold text-muted">Email Address</label>
                    <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="email" placeholder="john@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label small fw-semibold text-muted">Password (min 8 characters)</label>
                    <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label small fw-semibold text-muted">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-purple btn-pill w-100 py-2">Create Account</button>
            </form>

            <div class="text-center mt-4">
                <span class="text-muted small">Already have an account?</span>
                <a asp-page="/Account/Login" class="text-decoration-none fw-semibold small text-primary ms-1">Sign in here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
